# Stricter gate for the code that handles money and order state.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9
    paths:
        - app/Domain
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true
    # Same setting as phpstan.neon: a generic declared in a docblock describes the
    # supported input, not a guarantee about what the framework will actually hand
    # us at runtime, so defensive type checks against it are not "always true".
    treatPhpDocTypesAsCertain: false
