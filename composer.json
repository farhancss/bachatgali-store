{
    "name": "bachatgali/store",
    "type": "project",
    "description": "Bachat Gali — cash-on-delivery commerce platform (Laravel 13 + Inertia + Vue 3).",
    "keywords": ["ecommerce", "laravel", "inertia", "cash-on-delivery"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^6.0",
        "laravel/octane": "^2.0",
        "laravel/pulse": "^1.4",
        "laravel/scout": "^10.0",
        "laravel/tinker": "^2.10",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-model-states": "^2.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-responsecache": "^7.0",
        "spatie/laravel-schema-org": "^1.0",
        "spatie/laravel-sitemap": "^7.0",
        "tightenco/ziggy": "^2.0",
        "typesense/typesense-php": "^5.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-typescript-transformer": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "types": "phpstan analyse --memory-limit=1G",
        "types:domain": "phpstan analyse -c phpstan-domain.neon --memory-limit=1G",
        "refactor": "rector --dry-run",
        "refactor:fix": "rector",
        "test": "pest --parallel",
        "test:arch": "pest --group=arch",
        "test:cov": "pest --parallel --coverage --min=85",
        "test:type": "pest --type-coverage --min=95",
        "test:mutate": "pest --mutate --covered-only --min=75 --path=app/Domain/Pricing,app/Domain/Cod",
        "check": [
            "@lint",
            "@types",
            "@types:domain",
            "@refactor",
            "@test:arch",
            "@test:cov",
            "@test:type"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
