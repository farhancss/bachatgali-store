{
    "name": "bachatgali/store",
    "type": "project",
    "description": "Bachat Gali \u2014 cash-on-delivery commerce platform (Laravel 13 + Inertia + Vue 3).",
    "keywords": [
        "ecommerce",
        "laravel",
        "inertia",
        "cash-on-delivery"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.12",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.23",
        "laravel/horizon": "^5.48",
        "laravel/octane": "^2.19",
        "laravel/pulse": "^1.8",
        "laravel/scout": "^11.5",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.2",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-model-states": "^2.14",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-responsecache": "^8.4",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/schema-org": "^5.0",
        "tightenco/ziggy": "^2.6",
        "typesense/typesense-php": "^5.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.6",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "types": "phpstan analyse --memory-limit=1G",
        "types:domain": "phpstan analyse -c phpstan-domain.neon --memory-limit=1G",
        "refactor": "rector --dry-run",
        "refactor:fix": "rector",
        "test": "pest --parallel",
        "test:arch": "pest --group=arch",
        "test:cov": "pest --parallel --coverage --min=85",
        "test:type": "pest --type-coverage --min=95",
        "test:mutate": "pest --mutate --covered-only --min=75 --path=app/Domain/Pricing,app/Domain/Cod",
        "check": [
            "@lint",
            "@types",
            "@types:domain",
            "@refactor",
            "@test:arch",
            "@test:cov",
            "@test:type"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
