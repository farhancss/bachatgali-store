APP_NAME="Bachat Gali"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Storefront ────────────────────────────────────────────────
STORE_CURRENCY=PKR
STORE_CURRENCY_SYMBOL="Rs."
STORE_FREE_DELIVERY_THRESHOLD=250000      # paisa — Rs. 2,500
STORE_SUPPORT_WHATSAPP="+92XXXXXXXXXX"

# ── Cash on delivery ──────────────────────────────────────────
COD_ENABLED=true
COD_HANDLING_FEE=0
COD_MAX_ORDER_VALUE=5000000               # paisa — Rs. 50,000
COD_MAX_ORDER_VALUE_NEW_CUSTOMER=1500000  # paisa — Rs. 15,000
COD_REQUIRE_OTP=true
COD_OTP_TTL_SECONDS=300
COD_HIGH_RISK_REQUIRES_CALL=true

# ── Database ──────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bachatgali
DB_USERNAME=bachatgali
DB_PASSWORD=secret

# ── Cache / queue / session ───────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Search ────────────────────────────────────────────────────
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense_dev_key

# ── Courier gateways (see docs/03-cod-operations.md) ──────────
COURIER_DEFAULT=fake
POSTEX_TOKEN=
POSTEX_BASE_URL=https://api.postex.pk
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
TCS_USERNAME=
TCS_PASSWORD=

# ── Notifications ─────────────────────────────────────────────
SMS_DRIVER=fake
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bachatgali.store"
MAIL_FROM_NAME="${APP_NAME}"

# ── Media / storage ───────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=

# ── Observability ─────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
PULSE_ENABLED=true

# ── Performance ───────────────────────────────────────────────
OCTANE_SERVER=frankenphp
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=3600
